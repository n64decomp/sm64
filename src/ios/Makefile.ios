# On-device build Makefile for the SM64 iOS port.
# Runs directly on the jailbroken iOS device (clang 3.7.1 / make / ldid
# compiling against the live root filesystem's frameworks -- there is no
# separate cross SDK on this toolchain).
#
# This currently builds only the smoke-test shell app (src/ios/app) to
# validate the full build -> sign -> install -> launch pipeline. Game
# sources are added incrementally as platform backends land.

APP_NAME    := SM64
BUNDLE_ID   := com.sm64decomp.ios
EXECUTABLE  := sm64ios
BUILD_DIR   := build
APP_DIR     := $(BUILD_DIR)/$(APP_NAME).app

CC          := clang
ARCH        := armv7
IOS_MIN     := 6.0

SYSROOT     := /private/var/sdk

CFLAGS      := -arch $(ARCH) -miphoneos-version-min=$(IOS_MIN) -fobjc-arc \
               -isysroot $(SYSROOT) -Wall -O2 -fmessage-length=0
FRAMEWORKS  := -framework UIKit -framework Foundation -framework CoreGraphics
LDFLAGS     := -arch $(ARCH) -miphoneos-version-min=$(IOS_MIN) -isysroot $(SYSROOT) $(FRAMEWORKS)

SRCS        := app/main.m app/SM64AppDelegate.m
OBJS        := $(patsubst app/%.m,$(BUILD_DIR)/obj/%.o,$(SRCS))

LIBULTRA_SHIM_SRCS := libultra_shim/multilibultra_thread.c libultra_shim/multilibultra_mesg.c libultra_shim/multilibultra_sptask.c libultra_shim/multilibultra_vi.c libultra_shim/multilibultra_misc.c
LIBULTRA_TEST_SRCS := libultra_shim/test_multilibultra.c
LIBULTRA_SPTASK_TEST_SRCS := libultra_shim/test_multilibultra_sptask.c
LIBULTRA_VI_TEST_SRCS := libultra_shim/test_multilibultra_vi.c
LIBULTRA_INCLUDES  := -I../../include

.PHONY: all app install run clean libultra_test libultra_sptask_test libultra_vi_test

all: app

$(BUILD_DIR)/obj/%.o: app/%.m
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

app: $(OBJS)
	@mkdir -p $(APP_DIR)
	$(CC) $(LDFLAGS) -o $(APP_DIR)/$(EXECUTABLE) $(OBJS)
	cp app/Info.plist $(APP_DIR)/Info.plist
	ldid -S $(APP_DIR)/$(EXECUTABLE)
	@echo "Built $(APP_DIR)"

# Standalone CLI test for the libultra threading/messaging shim -- not part
# of the app bundle, just a native executable run directly over SSH.
libultra_test:
	@mkdir -p $(BUILD_DIR)
	$(CC) -arch $(ARCH) -miphoneos-version-min=$(IOS_MIN) -isysroot $(SYSROOT) \
	    -D_LANGUAGE_C -D_FORTIFY_SOURCE=0 $(LIBULTRA_INCLUDES) -Wall -O0 -g \
	    $(LIBULTRA_SHIM_SRCS) $(LIBULTRA_TEST_SRCS) \
	    -o $(BUILD_DIR)/libultra_test
	ldid -S $(BUILD_DIR)/libultra_test
	@echo "Built $(BUILD_DIR)/libultra_test"

# Standalone CLI test for the SP/DP task dispatch shim.
libultra_sptask_test:
	@mkdir -p $(BUILD_DIR)
	$(CC) -arch $(ARCH) -miphoneos-version-min=$(IOS_MIN) -isysroot $(SYSROOT) \
	    -D_LANGUAGE_C -D_FORTIFY_SOURCE=0 $(LIBULTRA_INCLUDES) -Wall -O0 -g \
	    $(LIBULTRA_SHIM_SRCS) $(LIBULTRA_SPTASK_TEST_SRCS) \
	    -o $(BUILD_DIR)/libultra_sptask_test
	ldid -S $(BUILD_DIR)/libultra_sptask_test
	@echo "Built $(BUILD_DIR)/libultra_sptask_test"

# Standalone CLI test for the VI vblank + misc os*() shims.
libultra_vi_test:
	@mkdir -p $(BUILD_DIR)
	$(CC) -arch $(ARCH) -miphoneos-version-min=$(IOS_MIN) -isysroot $(SYSROOT) \
	    -D_LANGUAGE_C -D_FORTIFY_SOURCE=0 $(LIBULTRA_INCLUDES) -Wall -O0 -g \
	    $(LIBULTRA_SHIM_SRCS) $(LIBULTRA_VI_TEST_SRCS) \
	    -o $(BUILD_DIR)/libultra_vi_test
	ldid -S $(BUILD_DIR)/libultra_vi_test
	@echo "Built $(BUILD_DIR)/libultra_vi_test"

clean:
	rm -rf $(BUILD_DIR)
